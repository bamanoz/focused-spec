{
  "name": "focused-spec",
  "version": "0.8.2",
  "description": "Executable evidence for focused behavioral specifications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bamanoz/focused-spec.git"
  },
  "type": "module",
  "bin": {
    "focused-spec": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runner": "./dist/runner-api.js"
  },
  "files": [
    "dist",
    "skills",
    "guidance",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck:tests": "tsc -p test/tsconfig.json && tsc -p examples/openspec/tsconfig.json && tsc -p evals/tsconfig.json",
    "test": "npm run build && npm run typecheck:tests && vitest run",
    "check": "npm test",
    "smoke": "node dist/cli.js run --root examples/openspec",
    "preeval:agent": "npm run build",
    "eval:agent": "node --experimental-strip-types evals/run.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "fast-glob": "^3.3.3",
    "mdast-util-from-markdown": "^2.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "focused-spec": "^0.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "license": "MIT"
}
